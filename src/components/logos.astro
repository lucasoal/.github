---
// @ts-ignore
import { Icon } from "astro-icon/components";
---

<div class="mt-24">
  <h2 class="text-center text-slate-500">I work/have worked with some technologies.</h2>
  <div class="flex gap-8 md:gap-20 items-center justify-center mt-10 flex-wrap">

    <Icon class="size-8 md:size-8" title="python" name="simple-icons:python" />
    <Icon class="size-8 md:size-8" title="pyspark" name="simple-icons:apachespark" />
    <Icon class="size-8 md:size-8" title="postgresql" name="simple-icons:postgresql" />
    <Icon class="size-8 md:size-8" title="mongodb" name="simple-icons:mongodb" />
    <Icon class="size-8 md:size-8" title="googlecloud" name="simple-icons:googlecloud" />
    <Icon class="size-8 md:size-8" title="microsoftazure" name="simple-icons:microsoftazure" />
    <Icon class="size-8 md:size-8" title="databricks" name="simple-icons:databricks" />
    <Icon class="size-8 md:size-8" title="apacheairflow" name="simple-icons:apacheairflow" />
    <Icon class="size-8 md:size-8" title="docker" name="simple-icons:docker" />
    <Icon class="size-8 md:size-8" title="powerbi" name="simple-icons:powerbi" />
    <Icon class="size-8 md:size-8" title="looker" name="simple-icons:looker" />

  </div>
</div>