---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

// Filter team entries with 'draft: false' & date before current date
const publishedTeamMembers = await getCollection("team", ({ data }) => {
return !data.draft && data.publishDate < new Date(); }); --- <Layout title="About">
  <Container>
    <Sectionhead>
      <Fragment slot="title">About</Fragment>
      <Fragment slot="desc">A short resume</Fragment>
    </Sectionhead>

    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-16">
      <h2 class="font-bold text-3xl text-gray-800">
        Bio
      </h2>
      <p class="text-lg leading-relaxed text-slate-500">
        🧑‍💻 Data Engineer | Former Digital Forensic Researcher | Open-Source Builder.<br>
        🇧🇷🇵🇹 Graduated in Brazil and Portugal (PUC Minas / IPG).<br>
        🚀 I build end-to-end systems, data pipelines and analytics; I find solutions and solve problems. <br>
        <br>
        I have been allocated to projects for clients such as Spotify (Brazil & LATAM), Heineken, 99, Itaú, Vale,
        Mercado Livre, and Merck, working with architecture, engineering, automation, ETL/ELT, and analytics.<br>
        <br>
        I'm interested in large-scale projects, cloud platforms (Azure, GCP, AWS), and technologies such as Python,
        Databricks, PySpark, SQL, Airflow, Data Factory, MongoDB, and PostgreSQL.<br>
        <br>
        I enjoy building solutions that make a real impact for businesses and customers.<br>
        <br>
        🧑‍💻 GitHub → Studies & Open-Source Projects<br>
        <br>
        ---<br>
        Core Technologies:<br>
        - Python, PySpark | SQL, NoSQL | GCP, Azure | Databricks, Airflow, Docker | Power BI, Looker | MongoDB,
        PostgreSQL
        (Complete list available in the Skills section)
      </p>
    </div>
    <div class="grid md:grid-cols-3 gap-10 mx-auto max-w-4xl mt-12">
      {
      publishedTeamMembers.map((teamMemberEntry) => (
      <div class="group">
        <div class="w-full aspect-square">
          <Picture src={teamMemberEntry.data.avatar.src} alt={teamMemberEntry.data.avatar.alt}
            sizes="(max-width: 800px) 100vw, 400px" width={400} height={400}
            class="w-full rounded-sm transition group-hover:-translate-y-1 group-hover:shadow-xl bg-white object-cover object-center aspect-square" />
        </div>

        <div class="mt-4 text-center">
          <h2 class="text-lg text-gray-800">{teamMemberEntry.data.name}</h2>
          <h3 class="text-sm text-slate-500">
            {teamMemberEntry.data.title}
          </h3>
        </div>
      </div>
      ))
      }
    </div>
  </Container>
  </Layout>